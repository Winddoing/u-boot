if ARCH_DFD

config SYS_BOARD
	default "dfd"

config SYS_CONFIG_NAME
	default "dfd"

config SYS_SOC
	default "dfd-soc"

config DFD_CONFIG
	bool "DFD config"
	default y
	select ARM64
	select GICV2
	select BINMAN
	select OF_CONTROL
	select DM_SERIAL
	select PL01X_SERIAL
	imply CMD_DM
	imply DFD_SPL_CFG

config DFD_SPL_CFG
	bool
	select SUPPORT_SPL
	select SPL
	select SPL_OF_CONTROL if SPL
	select SPL_DM if SPL
	select HAS_CUSTOM_SYS_INIT_SP_ADDR
	imply SPL_LIBCOMMON_SUPPORT if SPL
	imply SPL_LIBGENERIC_SUPPORT if SPL
	imply SPL_SYS_MALLOC_F if SPL
	imply SPL_SYS_MALLOC_SIMPLE if SPL


#if DFD_RAM_ADDR && SPL_SHARES_INIT_SP_ADDR
if DFD_SPL_CFG

config SPL_TEXT_BASE
	default 0xFFF01000

config SPL_MAX_SIZE
	default 0x1F000 if SPL_TEXT_BASE = 0xFFF01000

config SPL_SIZE_LIMIT
	default 0x1F000 if SPL_TEXT_BASE = 0xFFF01000

config SPL_BSS_START_ADDR
	default 0xFFF1C000 if SPL_TEXT_BASE = 0xFFF01000

config SPL_BSS_MAX_SIZE
	default 0x4000 if SPL_BSS_START_ADDR = 0xFFF1C000

config SPL_HAS_BSS_LINKER_SECTION
	default y if ARM64

config CUSTOM_SYS_INIT_SP_ADDR
	default 0xFFF19000 if SPL_TEXT_BASE = 0xFFF01000


config SYS_MALLOC_F_LEN
	default 0x3000 if CUSTOM_SYS_INIT_SP_ADDR = 0xFFF19000

config SPL_SYS_MALLOC_F_LEN
	default 0x3000 if CUSTOM_SYS_INIT_SP_ADDR = 0xFFF19000

config SPL_STACK_R
	default y if CUSTOM_SYS_INIT_SP_ADDR = 0xFFF19000

config SPL_STACK_R_ADDR
	default 0x1000000 if CUSTOM_SYS_INIT_SP_ADDR = 0xFFF19000

config SPL_STACK_R_MALLOC_SIMPLE_LEN
	default 0x200000 if SPL_STACK_R_ADDR = 0x1000000

config TEXT_BASE
	default 0x200000 if SPL_TEXT_BASE = 0xFFF01000

config SYS_LOAD_ADDR
	default 0x880000 if SPL_TEXT_BASE = 0xFFF01000
endif

endif
